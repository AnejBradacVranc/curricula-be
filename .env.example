# App
PORT=3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# PostgreSQL (docker-compose db service)
POSTGRES_USER=curricula
POSTGRES_PASSWORD=curricula
POSTGRES_DB=curricula
POSTGRES_PORT=5432

# Database connection (NestJS app inside Docker)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=curricula
DATABASE_PASSWORD=curricula
DATABASE_NAME=curricula
DATABASE_URL=postgresql://curricula:curricula@db:5432/curricula

# JWT
JWT_SECRET=change-me-in-production

# Database connection from your host machine (TablePlus, psql, DBeaver, etc.)
# DATABASE_URL=postgresql://curricula:curricula@localhost:5432/curricula
