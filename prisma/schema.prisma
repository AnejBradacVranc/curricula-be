// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model AdditionalActivities {
  id Int @id @default(autoincrement())
  name String //Razrednistvo, Informatika, Matura, OIV, PUT
  additionalTeacherAssignments AdditionalTeacherAssignment[]
}

model AdditionalTeacherAssignment{
  teacher     Teacher     @relation(fields: [teacherId], references: [id])
  additionalActivity    AdditionalActivities     @relation(fields: [additionalActivityId], references: [id])

  teacherId Int
  additionalActivityId Int
  hoursAmount Decimal @default(0) @db.Decimal(8, 4)

  @@id([teacherId, additionalActivityId])
}

model School {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  users    User[]
  programs Program[]
  subjects Subject[]
  teachers Teacher[]
  logo String?
  tel      String?
  email    String?
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  surname  String?
  password String
  school   School  @relation(fields: [schoolId], references: [id])
  schoolId Int
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Year {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  programYears ProgramYear[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Program {
  id              Int              @id @default(autoincrement())
  name            String
  school          School           @relation(fields: [schoolId], references: [id])
  schoolId        Int
  programYears    ProgramYear[]
  programSubjects ProgramSubject[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([schoolId, name])
}

//department albels a, b, c, d, e, f, cr, gr, tr...etc
model ClassLabel {
  id    Int    @id @default(autoincrement())
  label String @unique // "a", "b", "c"
  classes Class[]
}

model Class {
  id        Int @id @default(autoincrement())
  programId Int
  yearId    Int
  labelId   Int

  program     Program     @relation(fields: [programId], references: [id])
  programYear ProgramYear @relation(fields: [programId, yearId], references: [programId, yearId])
  label       ClassLabel  @relation(fields: [labelId], references: [id])
  assignments ClassSubjectAssignment[]
  @@unique([ programId, yearId, labelId])
}


model ProgramYear {
  program         Program          @relation(fields: [programId], references: [id])
  year            Year             @relation(fields: [yearId], references: [id])
  programId       Int
  yearId          Int
  numWeeks        Int
  programSubjects ProgramSubject[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@id([programId, yearId])
}

model Category{
  id Int @id @default(autoincrement())
  name String @unique
  subjects Subject[]
}

model Subject {
  id              Int              @id @default(autoincrement())
  name            String
  school          School           @relation(fields: [schoolId], references: [id])
  category        Category @relation(fields: [categoryId], references: [id])
  abbrevation String
  schoolId        Int
  categoryId      Int
  programSubjects ProgramSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([schoolId, name])
}

model ProgramSubject {
  program       Program     @relation(fields: [programId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  programYear   ProgramYear @relation(fields: [programId, yearId], references: [programId, yearId])
  assignments ClassSubjectAssignment[]
  
  requiredHours Decimal     @db.Decimal(8, 4)
  programId     Int
  subjectId     Int
  yearId        Int

  @@id([programId, subjectId, yearId])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ClassSubjectAssignment {
  classId   Int
  programId Int
  subjectId Int
  yearId    Int
  teacherId Int

  class          Class          @relation(fields: [classId], references: [id])
  programSubject ProgramSubject @relation(fields: [programId, subjectId, yearId], references: [programId,subjectId,yearId])
  teacher        Teacher        @relation(fields: [teacherId], references: [id])
  @@id([classId, programId, subjectId, yearId])
}

model Teacher {
  id              Int              @id @default(autoincrement())
  school          School           @relation(fields: [schoolId], references: [id])  
  name            String
  surname         String
  email           String           @unique
  color String?
  schoolId        Int  
  assignedHours   Decimal          @default(0) @db.Decimal(8, 4)
  additionalActivityHours Decimal @default(0) @db.Decimal(8, 4) 
  totalHours Decimal @default(0) @db.Decimal(8, 4)

  additionalActivityAssignments AdditionalTeacherAssignment[]

  assignments ClassSubjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
