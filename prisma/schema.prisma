// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model School {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  users    User[]
  programs Program[]
  subjects Subject[]
  teachers Teacher[]
  tel      String?
  email    String?
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  surname  String?
  password String
  school   School  @relation(fields: [schoolId], references: [id])
  schoolId Int
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Year {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  programYears ProgramYear[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Program {
  id              Int              @id @default(autoincrement())
  name            String
  school          School           @relation(fields: [schoolId], references: [id])
  schoolId        Int
  availableHours  Decimal          @db.Decimal(8, 2)
  programYears    ProgramYear[]
  programSubjects ProgramSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([schoolId, name])
}

model ProgramYear {
  program         Program          @relation(fields: [programId], references: [id])
  year            Year             @relation(fields: [yearId], references: [id])
  programId       Int
  yearId          Int
  numWeeks        Int
  programSubjects ProgramSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@id([programId, yearId])
}

model Subject {
  id              Int              @id @default(autoincrement())
  name            String
  school          School           @relation(fields: [schoolId], references: [id])
  schoolId        Int
  programSubjects ProgramSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([schoolId, name])
}

model ProgramSubject {
  program       Program     @relation(fields: [programId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  programYear   ProgramYear @relation(fields: [programId, yearId], references: [programId, yearId])
  teacher       Teacher?    @relation(fields: [teacherId], references: [id])
  programId     Int
  subjectId     Int
  yearId        Int
  teacherId     Int?
  requiredHours Decimal     @db.Decimal(8, 2)

  @@id([programId, subjectId, yearId])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Teacher {
  id              Int              @id @default(autoincrement())
  school          School           @relation(fields: [schoolId], references: [id])
  name            String
  surname         String
  email           String           @unique
  schoolId        Int
  programSubjects ProgramSubject[]
  assignedHours   Decimal          @default(0) @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
